{
  "namespace": "dev.engnotes.fes.events",
  "type": "record",
  "name": "TradeEvent",
  "doc": "Raw trade execution event from the trade producer or the migration normalizer",
  "fields": [
    {"name": "tradeId", "type": "string",
     "doc": "Unique identifier for this trade execution"},
    {"name": "correlationId", "type": "string",
     "doc": "Cross-service trace identifier, propagated through the pipeline"},
    {"name": "ticker", "type": "string",
     "doc": "NSE/BSE ticker symbol, for example RELIANCE or TCS"},
    {"name": "quantity", "type": "long",
     "doc": "Number of shares traded"},
    {"name": "price", "type": "double",
     "doc": "Execution price in INR"},
    {"name": "side", "type": {"type": "enum", "name": "Side", "symbols": ["BUY", "SELL"]},
     "doc": "Trade direction"},
    {"name": "traderId", "type": "string",
     "doc": "Identifier of the trader or algorithm placing the order. RESTRICTED."},
    {"name": "accountId", "type": "string",
     "doc": "Account identifier for position tracking. RESTRICTED."},
    {"name": "eventTimestamp", "type": {"type": "long", "logicalType": "timestamp-millis"},
     "doc": "When the trade was executed"},
    {"name": "producedAt", "type": {"type": "long", "logicalType": "timestamp-millis"},
     "doc": "When this event was produced to Kafka"},
    {"name": "traceContext", "type": {"type": "map", "values": "string"}, "default": {},
     "doc": "W3C TraceContext headers for distributed tracing"},

    {"name": "sourceSystem", "type": ["null", "string"], "default": null,
     "doc": "CDC provenance: originating legacy system. Null for native live producers."},
    {"name": "sourceRecordKey", "type": ["null", "string"], "default": null,
     "doc": "CDC provenance: primary key in the legacy source table"},
    {"name": "sourceChangePosition", "type": ["null", "string"], "default": null,
     "doc": "CDC provenance: connector position such as the PostgreSQL LSN"},
    {"name": "migrationBatchId", "type": ["null", "string"], "default": null,
     "doc": "CDC provenance: snapshot or backfill batch identifier"}
  ]
}
