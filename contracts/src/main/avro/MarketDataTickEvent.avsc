{
  "namespace": "dev.engnotes.fes.events",
  "type": "record",
  "name": "MarketDataTickEvent",
  "doc": "Price tick from the market data simulator. Fields follow FR-01.2; prices are generated by the GBM model and volume by a Pareto distribution (ADR-006). This schema was absent from specification-v1.2 and is derived from the requirement.",
  "fields": [
    {"name": "tickId", "type": "string"},
    {"name": "ticker", "type": "string"},
    {"name": "bidPrice", "type": "double", "doc": "Best bid in INR"},
    {"name": "askPrice", "type": "double", "doc": "Best ask in INR"},
    {"name": "lastTradedPrice", "type": "double", "doc": "Last traded price in INR"},
    {"name": "volume", "type": "long"},
    {"name": "eventTimestamp", "type": {"type": "long", "logicalType": "timestamp-millis"},
     "doc": "When the tick was observed"},
    {"name": "producedAt", "type": {"type": "long", "logicalType": "timestamp-millis"},
     "doc": "When this event was produced to Kafka"},
    {"name": "correlationId", "type": "string"},
    {"name": "traceContext", "type": {"type": "map", "values": "string"}, "default": {}}
  ]
}
