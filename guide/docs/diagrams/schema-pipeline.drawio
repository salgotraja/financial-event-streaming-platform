<mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="980" pageHeight="800" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" value="From a .avsc file to a subject a producer can use">
      <mxGeometry x="30" y="22" width="900" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="sub" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;" value="Two independent checks: a merge-time gate that needs no registry, and a provisioning step that needs no producer.">
      <mxGeometry x="30" y="56" width="920" height="22" as="geometry"/>
    </mxCell>

    <mxCell id="s1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=14;verticalAlign=middle;" value="&lt;b&gt;1. Edit the contract&lt;/b&gt;&lt;br&gt;contracts/src/main/avro/TradeEvent.avsc">
      <mxGeometry x="30" y="96" width="500" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=14;verticalAlign=middle;" value="&lt;b&gt;2. Generate types&lt;/b&gt;&lt;br&gt;Avro plugin, 31 Java types at build time">
      <mxGeometry x="30" y="196" width="500" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacingLeft=14;verticalAlign=middle;" value="&lt;b&gt;3. The merge-time gate&lt;/b&gt;&lt;br&gt;SchemaCompatibilityTest: FULL, offline, no registry&lt;br&gt;against src/test/resources/schema-baseline">
      <mxGeometry x="30" y="296" width="500" height="86" as="geometry"/>
    </mxCell>
    <mxCell id="s4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=left;spacingLeft=14;verticalAlign=middle;" value="&lt;b&gt;4. Name the subject&lt;/b&gt;&lt;br&gt;deploy/compose/subjects.tsv">
      <mxGeometry x="30" y="412" width="500" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=14;verticalAlign=middle;" value="&lt;b&gt;5. Register, then use&lt;/b&gt;&lt;br&gt;local-stack.sh POSTs each subject&lt;br&gt;producers run auto.register.schemas=false">
      <mxGeometry x="30" y="512" width="500" height="86" as="geometry"/>
    </mxCell>

    <mxCell id="a1" parent="1" source="s1" target="s2" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a2" parent="1" source="s2" target="s3" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a3" parent="1" source="s3" target="s4" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;endArrow=block;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#4a7f3a;" value="pass">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a4" parent="1" source="s4" target="s5" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="why" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" value="&lt;b&gt;Why FULL, not BACKWARD&lt;/b&gt;&lt;br&gt;&lt;br&gt;BACKWARD alone permits field removal: a new reader just ignores the dropped field.&lt;br&gt;&lt;br&gt;FULL is also what a rolling upgrade needs, where two versions are live at once.">
      <mxGeometry x="580" y="96" width="370" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="ref" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" value="&lt;b&gt;One definition, not two&lt;/b&gt;&lt;br&gt;&lt;br&gt;EnrichedTradeEvent embeds TradeEvent, so it registers as a reference to trades.raw-value rather than inlining it.&lt;br&gt;&lt;br&gt;Inlining would give the registry two definitions of one record.">
      <mxGeometry x="580" y="326" width="370" height="220" as="geometry"/>
    </mxCell>

    <mxCell id="fail" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" value="&lt;b&gt;When the gate fails&lt;/b&gt;&lt;br&gt;&lt;br&gt;Allowed: add an optional field with a default, widen a union.&lt;br&gt;Not allowed: remove or rename a field, change a type, add a mandatory field without a default.&lt;br&gt;&lt;br&gt;Accept a deliberate break with ./gradlew updateSchemaBaseline, which produces a reviewable diff.">
      <mxGeometry x="30" y="630" width="920" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="a5" parent="1" source="s3" target="fail" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;endArrow=block;strokeWidth=2;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.02;entryY=0;entryDx=0;entryDy=0;fontSize=13;fontStyle=1;fontColor=#b85450;" value="fail">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="10" y="339"/><mxPoint x="10" y="630"/></Array></mxGeometry>
    </mxCell>
  </root>
</mxGraphModel>
