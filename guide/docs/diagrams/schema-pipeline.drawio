<mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1480" pageHeight="760" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" value="From a .avsc file to a registry subject a producer can use">
      <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="sub" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="Two independent checks stand between an edited schema and a running producer: a merge-time gate that needs no registry, and a provisioning step that needs no producer.">
      <mxGeometry x="40" y="50" width="1300" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="s1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="1. Edit the contract&#10;&#10;contracts/src/main/avro/&#10;TradeEvent.avsc&#10;&#10;16 schemas, namespace&#10;dev.engnotes.fes.events">
      <mxGeometry x="40" y="110" width="240" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="s2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="2. Generate types&#10;&#10;com.github.davidmc24 Avro plugin&#10;stringType = String&#10;31 Java types at build time&#10;&#10;No hand-written duplicates">
      <mxGeometry x="330" y="110" width="240" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="s3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="3. The merge-time gate&#10;&#10;SchemaCompatibilityTest&#10;mutualReadStrategy().validateLatest()&#10;against src/test/resources/&#10;schema-baseline&#10;&#10;FULL, offline, no registry needed">
      <mxGeometry x="620" y="110" width="250" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="s4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="4. Name the subject&#10;&#10;deploy/compose/subjects.tsv&#10;topic &#8594; schema file &#8594; reference&#10;&#10;A topic with no row here fails&#10;at the first record, not at startup">
      <mxGeometry x="920" y="110" width="250" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="s5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="5. Register and use&#10;&#10;local-stack.sh POSTs to&#10;/subjects/{topic}-value/versions&#10;&#10;Registry compatibility FULL&#10;Producers run&#10;auto.register.schemas=false">
      <mxGeometry x="1220" y="110" width="240" height="150" as="geometry"/>
    </mxCell>

    <mxCell id="a1" parent="1" source="s1" target="s2" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a2" parent="1" source="s2" target="s3" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a3" parent="1" source="s3" target="s4" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;endArrow=block;fontSize=10;" value="pass">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a4" parent="1" source="s4" target="s5" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="fail" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="The build fails, with the rule spelled out&#10;&#10;Allowed: add an optional field with a default, widen a union.&#10;Not allowed: remove a field, rename a field, change a type, add a mandatory field without a default, make an optional field mandatory, remove an enum symbol.&#10;&#10;Accepting a deliberate break is an explicit action that produces a reviewable diff:&#10;./gradlew updateSchemaBaseline">
      <mxGeometry x="560" y="330" width="380" height="190" as="geometry"/>
    </mxCell>
    <mxCell id="a5" parent="1" source="s3" target="fail" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;endArrow=block;fontSize=10;" value="fail">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="why" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="Why FULL rather than BACKWARD&#10;&#10;BACKWARD alone permits field removal, because a new reader simply ignores the dropped field. The stated evolution policy is new optional fields with defaults, no removal, no type changes, and only FULL enforces that as written.&#10;&#10;FULL is also what a rolling upgrade needs: two schema versions are live at once, and an old consumer must still read a new producer's output.">
      <mxGeometry x="40" y="330" width="480" height="190" as="geometry"/>
    </mxCell>

    <mxCell id="ref" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="One definition, not two&#10;&#10;EnrichedTradeEvent embeds TradeEvent. It registers as a reference:&#10;&#10;trades.enriched  EnrichedTradeEvent.avsc&#10;dev.engnotes.fes.events.TradeEvent=trades.raw-value&#10;&#10;Inlining the type would give the registry two definitions of one record and let them drift. Referenced subjects are listed first in subjects.tsv so the version resolves.">
      <mxGeometry x="980" y="330" width="480" height="190" as="geometry"/>
    </mxCell>

    <mxCell id="counts" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="What the numbers are today&#10;&#10;16 schema files &#183; 31 generated Java types &#183; 19 registered subjects, being 15 domain subjects plus 4 dead-letter subjects, all four carrying DeadLetterEvent&#10;&#10;Deliberately absent: legacy.trades.cdc carries the Debezium connector's own envelope rather than a schema this repository owns, and remediation.requested and precedent.graph.sync have no schema yet.">
      <mxGeometry x="40" y="560" width="1420" height="140" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
