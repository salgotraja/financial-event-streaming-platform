<mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1480" pageHeight="860" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" value="Inside the only consumer in the platform">
      <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="sub" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="audit-service. Every decision on this path exists because at-least-once delivery and one poison record are both certain to happen.">
      <mxGeometry x="40" y="50" width="1300" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="in" parent="1" vertex="1" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="Four evidence topics&#10;trades.raw&#10;market-data.ticks&#10;corporate-actions&#10;reference-data.instruments&#10;&#10;fes.audit-service.topics, split on comma">
      <mxGeometry x="40" y="110" width="250" height="140" as="geometry"/>
    </mxCell>

    <mxCell id="listener" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="AuditRecordConsumer&#10;&#10;@KafkaListener, group audit-service&#10;ConsumerRecord of String and byte[]&#10;&#10;archiveService.archive(record);&#10;acknowledgment.acknowledge();">
      <mxGeometry x="350" y="110" width="290" height="140" as="geometry"/>
    </mxCell>

    <mxCell id="archive" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="AuditArchiveService&#10;&#10;1. build ArchivedRecord: topic, partition, offset, key, eventType, payload, timestamp&#10;2. skip if idempotencyKey is in the window&#10;3. sink.write(archived)&#10;4. only then mark it seen">
      <mxGeometry x="700" y="110" width="330" height="140" as="geometry"/>
    </mxCell>

    <mxCell id="sink" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="AuditSink&#10;&#10;LoggingAuditSink today: logs the record and discards it.&#10;&#10;S3 Parquet, the sidecar manifest, the KMS signature and Object Lock retention are Phase 3.">
      <mxGeometry x="1080" y="110" width="360" height="140" as="geometry"/>
    </mxCell>

    <mxCell id="decoder" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="AuditEventDecoder&#10;&#10;KafkaAvroDeserializer with SPECIFIC_AVRO_READER=false: generic, so this module needs no compile-time dependency on every schema in the platform.&#10;&#10;Returns the writer schema's name as eventType, which is what an S3 key's event_type= partition needs. A null value returns &quot;Tombstone&quot;, legitimate on the compacted topic.&#10;&#10;Decoding never produces the archived bytes.">
      <mxGeometry x="700" y="300" width="330" height="230" as="geometry"/>
    </mxCell>

    <mxCell id="dedup" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="The idempotency key&#10;&#10;topic + &quot;-&quot; + partition + &quot;-&quot; + offset&#10;&#10;An access-ordered LinkedHashMap bounded at recent-record-window = 100000, wrapped synchronized.&#10;&#10;What it covers: redelivery of uncommitted offsets inside a running consumer, which is what at-least-once actually produces.&#10;&#10;What it does not: a restart, or a replay older than the window. Restart-safe deduplication belongs to the durable sink, whose object key carries the offset range.">
      <mxGeometry x="350" y="300" width="330" height="290" as="geometry"/>
    </mxCell>

    <mxCell id="errors" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="DefaultErrorHandler&#10;&#10;ExponentialBackOff: 100ms initial, x2, 5s cap, 5s max elapsed, 2 retries, so three attempts in total.&#10;&#10;addNotRetryableExceptions(AuditDecodeException.class): the bytes do not improve, so a decode failure goes straight to the recoverer.&#10;&#10;setRetryListeners(failureTracker): the quarantined event carries a real retryCount and firstFailureAt rather than two values invented at quarantine time.&#10;&#10;setAckAfterHandle(true): the offset advances past a recovered record, so one poison payload never blocks the partition.">
      <mxGeometry x="1080" y="300" width="360" height="290" as="geometry"/>
    </mxCell>

    <mxCell id="dlq" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="DeadLetterPublisher &#183; platform-common&#10;&#10;Topic name is derived, never configured: record.topic() + &quot;.dlq&quot;, lowercase, not Spring Kafka's .DLT. A service cannot ship a name no replay tool looks at.&#10;&#10;Keeps the original key, so a quarantined record and the records behind it for that key stay on one partition and a replay preserves their order.&#10;&#10;Carries the delivered bytes, the whole cause chain, the root cause class and message, a 500-character stack trace summary, the attempts actually made, both failure timestamps, the consumer group and instance.&#10;&#10;The recoverer joins on the send. A quarantine that failed silently while the offset advanced is the one outcome an evidence archive cannot have.">
      <mxGeometry x="40" y="300" width="290" height="290" as="geometry"/>
    </mxCell>

    <mxCell id="dlqtopic" parent="1" vertex="1" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" value="{topic}.dlq&#10;DeadLetterEvent, 30 days, source-aligned partitions">
      <mxGeometry x="40" y="620" width="290" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="e1" parent="1" source="in" target="listener" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=block;fontSize=10;" value="byte[]">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" parent="1" source="listener" target="archive" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e3" parent="1" source="archive" target="sink" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;endArrow=block;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e4" parent="1" source="archive" target="decoder" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;endArrow=block;dashed=1;fontSize=10;" value="classify">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e5" parent="1" source="archive" target="dedup" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;endArrow=block;dashed=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e6" parent="1" source="decoder" target="errors" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;endArrow=block;fontSize=10;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e7" parent="1" source="errors" target="dlq" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;endArrow=block;fontSize=10;" value="recover">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e8" parent="1" source="dlq" target="dlqtopic" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;endArrow=block;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="ordernote" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="The ordering in step 3 and 4 is the whole point&#10;&#10;Marking the key seen before the sink accepted the record would make a failed write look like a completed one to the retry that follows. The record would then be dropped rather than quarantined: a silent hole in the evidence trail, with nothing failing anywhere.">
      <mxGeometry x="380" y="620" width="640" height="120" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
