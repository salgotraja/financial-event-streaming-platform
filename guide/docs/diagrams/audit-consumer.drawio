<mxGraphModel dx="1000" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="980" pageHeight="1120" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" value="Inside the only consumer in the platform">
      <mxGeometry x="30" y="22" width="920" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="sub" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;" value="Every decision here exists because two things are certain: at-least-once produces duplicates, and one record will fail to decode.">
      <mxGeometry x="30" y="56" width="920" height="22" as="geometry"/>
    </mxCell>

    <mxCell id="hdrl" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#666666;" value="The path a record takes">
      <mxGeometry x="30" y="90" width="520" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="hdrr" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#666666;" value="Where it goes, and why it works">
      <mxGeometry x="570" y="90" width="380" height="22" as="geometry"/>
    </mxCell>

    <mxCell id="in" parent="1" vertex="1" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;Four evidence topics&lt;/b&gt;&lt;br&gt;trades.raw, market-data.ticks, corporate-actions, reference-data.instruments">
      <mxGeometry x="30" y="120" width="520" height="66" as="geometry"/>
    </mxCell>
    <mxCell id="listener" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;AuditRecordConsumer&lt;/b&gt; &#183; @KafkaListener, group audit-service&lt;br&gt;&lt;br&gt;archiveService.archive(record); then acknowledgment.acknowledge();&lt;br&gt;&lt;br&gt;The value arrives as byte[]. The offset is committed here, never by a timer.">
      <mxGeometry x="30" y="226" width="520" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="archive" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;AuditArchiveService&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. build ArchivedRecord: topic, partition, offset, key, eventType, payload, timestamp&lt;br&gt;2. skip if the idempotency key is already in the window&lt;br&gt;3. sink.write(archived)&lt;br&gt;4. only then mark it seen">
      <mxGeometry x="30" y="396" width="520" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="decoder" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;AuditEventDecoder&lt;/b&gt; &#183; classifies, never produces the archived bytes&lt;br&gt;&lt;br&gt;A generic Avro reader, not a specific one, so this module needs no compile-time dependency on every schema in the platform.&lt;br&gt;&lt;br&gt;A null value returns Tombstone, legitimate on the compacted topic.">
      <mxGeometry x="30" y="576" width="520" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="errors" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;DefaultErrorHandler&lt;/b&gt;&lt;br&gt;&lt;br&gt;Three attempts total, 100ms doubling to a 5s cap.&lt;br&gt;AuditDecodeException is not retryable: the bytes do not improve.&lt;br&gt;setRetryListeners gives the DLQ event a real retryCount.&lt;br&gt;setAckAfterHandle(true): one poison payload never blocks the partition.">
      <mxGeometry x="30" y="756" width="520" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="dlq" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;DeadLetterPublisher&lt;/b&gt; &#183; platform-common&lt;br&gt;&lt;br&gt;Topic derived as record.topic() + &quot;.dlq&quot;, never configured per service.&lt;br&gt;Keeps the original key, so a replay preserves per-key order.&lt;br&gt;The recoverer joins on the send, so a failed quarantine stops the container.">
      <mxGeometry x="30" y="936" width="520" height="140" as="geometry"/>
    </mxCell>

    <mxCell id="e1" parent="1" source="in" target="listener" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=block;strokeWidth=2;fontSize=13;" value="byte[]">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" parent="1" source="listener" target="archive" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e3" parent="1" source="archive" target="decoder" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;endArrow=block;strokeWidth=2;fontSize=13;" value="classify">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e4" parent="1" source="decoder" target="errors" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;endArrow=block;strokeWidth=2;fontSize=13;" value="AuditDecodeException">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e5" parent="1" source="errors" target="dlq" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;endArrow=block;strokeWidth=2;fontSize=13;" value="recover">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="sink" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;AuditSink&lt;/b&gt;&lt;br&gt;&lt;br&gt;LoggingAuditSink today: logs the record and discards it.&lt;br&gt;&lt;br&gt;S3 Parquet, the sidecar manifest, the KMS signature and Object Lock retention are Phase 3, so no evidence claim rests on this yet.">
      <mxGeometry x="570" y="396" width="380" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="e6" parent="1" source="archive" target="sink" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;endArrow=block;strokeWidth=2;fontSize=13;verticalAlign=bottom;" value="write">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="n1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;Why 3 comes before 4&lt;/b&gt;&lt;br&gt;&lt;br&gt;Marking the key seen before the sink accepted the record makes a failed write look like a completed one to the retry that follows. The record is then dropped rather than quarantined: a silent hole in the evidence trail, with nothing failing anywhere.">
      <mxGeometry x="570" y="576" width="380" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="n2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;The idempotency key&lt;/b&gt; &#183; topic-partition-offset&lt;br&gt;&lt;br&gt;An access-ordered LinkedHashMap bounded at 100000.&lt;br&gt;&lt;br&gt;Covers redelivery inside a running consumer. Does not survive a restart: that belongs to the durable sink, whose object key carries the offset range.">
      <mxGeometry x="570" y="756" width="380" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="n3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;{topic}.dlq&lt;/b&gt;&lt;br&gt;&lt;br&gt;DeadLetterEvent, 30 days, source-aligned partitions.&lt;br&gt;&lt;br&gt;Quarantine is per record. There is no event-type-wide breaker: one would stop archiving every healthy record behind the poison one.">
      <mxGeometry x="570" y="936" width="380" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="e7" parent="1" source="dlq" target="n3" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;endArrow=block;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
