      <mxGeometry x="606" y="862" width="368" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="m11" parent="1" edge="1" style="html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=center;fontColor=#b85450;" value="11. offset advances anyway">
      <mxGeometry relative="1" as="geometry"><mxPoint x="694" y="916" as="sourcePoint"/><mxPoint x="502" y="916" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m11b" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#b85450;" value="the next record on the partition archives normally">
      <mxGeometry x="414" y="920" width="368" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="note1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontSize=14;" value="&lt;b&gt;Why bytes, not a deserialised event&lt;/b&gt;&lt;br&gt;&lt;br&gt;The archive's product is the payload that was published. A re-encoding would make an integrity check verify the re-encoding rather than the evidence.">
      <mxGeometry x="30" y="960" width="460" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="note2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;fontSize=14;" value="&lt;b&gt;What step 8 is not&lt;/b&gt;&lt;br&gt;&lt;br&gt;LoggingAuditSink logs the record and discards it. S3 Parquet, the signed manifest and Object Lock are Phase 3, so no evidence claim rests on this path yet.">
      <mxGeometry x="514" y="960" width="460" height="140" as="geometry"/>
    </mxCell>
