    <mxCell id="m3b" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="acks=all, enable.idempotence=true, lz4, 64KB batches">
      <mxGeometry x="118" y="334" width="440" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="m4" parent="1" edge="1" style="html=1;endArrow=open;dashed=1;strokeColor=#666666;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=center;" value="4. ack">
