    <mxCell id="m4b" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="only once min.insync.replicas=2 replicas hold the record">
      <mxGeometry x="118" y="402" width="440" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="m5" parent="1" edge="1" style="html=1;endArrow=block;strokeColor=#333333;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=center;" value="5. poll">
      <mxGeometry relative="1" as="geometry"><mxPoint x="502" y="466" as="sourcePoint"/><mxPoint x="694" y="466" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m5b" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="the value arrives as byte[], never as a deserialised object">
      <mxGeometry x="502" y="470" width="460" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="m6" parent="1" edge="1" style="html=1;endArrow=block;strokeColor=#333333;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=center;" value="6. resolve the writer schema">
      <mxGeometry relative="1" as="geometry"><mxPoint x="694" y="534" as="sourcePoint"/><mxPoint x="310" y="534" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m6b" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="its name becomes eventType; decoding never produces the archived bytes">
      <mxGeometry x="310" y="538" width="500" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="m7" parent="1" edge="1" style="html=1;endArrow=block;strokeColor=#333333;strokeWidth=2;fontSize=13;verticalAlign=middle;align=left;spacingLeft=8;" value="7. deduplicate on topic-partition-offset">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="694" y="588" as="sourcePoint"/>
