      <mxGeometry relative="1" as="geometry"><mxPoint x="694" y="676" as="sourcePoint"/><mxPoint x="886" y="676" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m8b" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="the bytes exactly as delivered">
      <mxGeometry x="606" y="680" width="368" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="m9" parent="1" edge="1" style="html=1;endArrow=block;strokeColor=#333333;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=center;" value="9. acknowledge">
      <mxGeometry relative="1" as="geometry"><mxPoint x="694" y="744" as="sourcePoint"/><mxPoint x="502" y="744" as="targetPoint"/></mxGeometry>
    </mxCell>
    <mxCell id="m9b" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="the offset is committed here, never by a timer">
      <mxGeometry x="414" y="748" width="368" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="alt" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#b85450;" value="alt &#183; the payload cannot be decoded (poison record)">
      <mxGeometry x="30" y="790" width="944" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="m10" parent="1" edge="1" style="html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=center;fontColor=#b85450;" value="10. quarantine to trades.raw.dlq">
