    <mxCell id="sub" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;" value="Every participant exists in the repository today. At-least-once, idempotent producers, explicit offset commits, no transactions.">
      <mxGeometry x="30" y="56" width="920" height="22" as="geometry"/>
    </mxCell>

