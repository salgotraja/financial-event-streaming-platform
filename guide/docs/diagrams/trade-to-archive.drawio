    <mxCell id="m2b" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="auto.register.schemas=false, so it is looked up, never created">
      <mxGeometry x="118" y="266" width="440" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="m3" parent="1" edge="1" style="html=1;endArrow=block;strokeColor=#333333;strokeWidth=2;fontSize=13;verticalAlign=bottom;align=center;" value="3. produce">
