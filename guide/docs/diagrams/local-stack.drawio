      <mxGeometry x="30" y="414" width="920" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="otel" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;fes-otel-collector&lt;/b&gt;&lt;br&gt;OTLP in on 4317 and 4318&lt;br&gt;metrics out on 8889, logs to Loki&lt;br&gt;traces to the debug exporter">
      <mxGeometry x="52" y="452" width="420" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="prom" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;fes-prometheus&lt;/b&gt; &#183; 9090, scrapes the collector&lt;br&gt;&lt;b&gt;fes-loki&lt;/b&gt; &#183; 3100&lt;br&gt;&lt;b&gt;fes-grafana&lt;/b&gt; &#183; 3000, anonymous admin, local only">
      <mxGeometry x="490" y="452" width="438" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="script" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=16;verticalAlign=top;spacingTop=12;" value="&lt;b&gt;scripts/local-stack.sh&lt;/b&gt; &#183; the sequence Compose cannot express&lt;br&gt;&lt;br&gt;up &#8594; wait for three healthy brokers and the registry &#8594; create topics from topics.tsv with explicit partition counts &#8594; register subjects from subjects.tsv &#8594; on strict-security only: render ACLs, apply them, then verify least privilege before declaring success&lt;br&gt;&lt;br&gt;down keeps volumes &#183; destroy deletes them &#183; status reports the profile and the subject count">
      <mxGeometry x="30" y="598" width="920" height="150" as="geometry"/>
    </mxCell>

    <mxCell id="dev" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" value="&lt;b&gt;dev&lt;/b&gt; &#183; scripts/local-stack.sh up dev&lt;br&gt;&lt;br&gt;PLAINTEXT on every listener, no authentication, no authorizer.&lt;br&gt;22 topics, 19 subjects.&lt;br&gt;&lt;br&gt;A convenience for iteration. Never evidence of production security, and the script says so on the way up.">
      <mxGeometry x="30" y="778" width="450" height="190" as="geometry"/>
    </mxCell>
    <mxCell id="strict" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" value="&lt;b&gt;strict-security&lt;/b&gt; &#183; scripts/local-stack.sh up strict-security&lt;br&gt;&lt;br&gt;SASL_SSL on the client, inter-broker and controller listeners, against a generated local CA.&lt;br&gt;allow.everyone.if.no.acl.found=false.&lt;br&gt;13 ACLs rendered from the committed per-service policies.&lt;br&gt;Least privilege asserted in both directions before the banner prints.">
      <mxGeometry x="500" y="778" width="450" height="190" as="geometry"/>
    </mxCell>
