    <mxCell id="script" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="scripts/local-stack.sh &#183; the sequence compose cannot express&#10;&#10;up &#8594; wait for three healthy brokers and the registry &#8594; create topics from topics.tsv with explicit partition counts &#8594; register subjects from subjects.tsv &#8594; on strict-security only: render ACLs, apply them, then verify least privilege before declaring success&#10;&#10;down keeps volumes, destroy deletes them, status reports the profile and the registered subject count">
      <mxGeometry x="65" y="390" width="640" height="205" as="geometry"/>
    </mxCell>

    <mxCell id="profiles" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="The two profiles">
      <mxGeometry x="40" y="640" width="400" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="dev" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="dev&#10;scripts/local-stack.sh up dev&#10;&#10;PLAINTEXT on every listener, no authentication, no authorizer&#10;22 topics, 19 subjects&#10;&#10;A convenience for iteration. It is never evidence of production security, and the script says so on the way up.">
      <mxGeometry x="40" y="674" width="680" height="190" as="geometry"/>
    </mxCell>
    <mxCell id="strict" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="strict-security&#10;scripts/local-stack.sh up strict-security&#10;&#10;SASL_SSL with SASL/PLAIN on the client, inter-broker and controller listeners, against a generated local CA&#10;StandardAuthorizer with allow.everyone.if.no.acl.found=false&#10;13 ACLs rendered from the committed per-service policies&#10;Least privilege asserted in both directions before the banner prints&#10;&#10;Certificates and credentials are generated into gitignored paths by scripts/generate-dev-security-material.sh">
      <mxGeometry x="760" y="674" width="680" height="190" as="geometry"/>
    </mxCell>
