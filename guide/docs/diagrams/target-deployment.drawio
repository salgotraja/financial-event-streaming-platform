    <mxCell id="agent" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=15;fontStyle=1;fontColor=#b85450;" value="Plane 5 &#183; agent investigation, outside the availability graph of Planes 1 to 3">
      <mxGeometry x="30" y="826" width="920" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="a1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;Investigation, review, precedent sync&lt;/b&gt;&lt;br&gt;reads anomaly.candidates only&lt;br&gt;typed tool gateway, no ledger credential">
      <mxGeometry x="52" y="866" width="410" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="a2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;Neo4j precedent graph&lt;/b&gt;&lt;br&gt;derived and rebuildable from reviewed cases&lt;br&gt;PostgreSQL stays authoritative">
      <mxGeometry x="498" y="866" width="430" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="e3" parent="1" source="vpc" target="agent" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;endArrow=block;strokeWidth=2;dashed=1;fontSize=13;fontColor=#b85450;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" value="anomaly.candidates, one way">
