<mxGraphModel dx="1000" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="980" pageHeight="1210" math="0" shadow="0" adaptiveColors="auto">
  <root>
