    <mxCell id="humans" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" value="&lt;b&gt;Human access is a separate path&lt;/b&gt;&lt;br&gt;&lt;br&gt;OIDC identity provider &#8594; admin control plane as the policy enforcement point &#8594; externalised OPA policy decision point &#8594; privileged operation.&lt;br&gt;&lt;br&gt;DLQ replay, rule approval, case disposition and audit export all pass through it, and each records actor, role, reason, target, decision and outcome.">
      <mxGeometry x="30" y="1000" width="920" height="150" as="geometry"/>
    </mxCell>

    <mxCell id="foot" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#666666;" value="EKS is the second profile: the same services under a Helm chart, one Kubernetes service account each via EKS Pod Identity, KEDA scaling consumers from lag, and SPIFFE/SPIRE for attested service-to-service mTLS in the advanced-security variant. It is an ephemeral validation environment with a tagged teardown plan, not the primary path.">
      <mxGeometry x="30" y="1160" width="920" height="46" as="geometry"/>
    </mxCell>
