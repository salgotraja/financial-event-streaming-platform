<mxGraphModel dx="1000" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="980" pageHeight="1160" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" value="One policy file, one parser, two consumers">
      <mxGeometry x="30" y="22" width="920" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="sub" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;" value="What a test proves and what a broker applies come from the same committed file, read by the same code.">
      <mxGeometry x="30" y="56" width="920" height="22" as="geometry"/>
    </mxCell>

    <mxCell id="src" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=16;fontStyle=1;" value="Source of truth &#183; one file per service, in that service's own module">
      <mxGeometry x="30" y="96" width="920" height="238" as="geometry"/>
    </mxCell>
    <mxCell id="p1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=14;" value="trade-producer/src/main/resources/security/kafka-acls.yml">
      <mxGeometry x="52" y="136" width="876" height="32" as="geometry"/>
    </mxCell>
    <mxCell id="p2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=14;" value="market-data-simulator/.../kafka-acls.yml">
      <mxGeometry x="52" y="174" width="876" height="32" as="geometry"/>
    </mxCell>
    <mxCell id="p3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=14;" value="corporate-action-producer/.../kafka-acls.yml">
      <mxGeometry x="52" y="212" width="876" height="32" as="geometry"/>
    </mxCell>
    <mxCell id="p4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=14;" value="reference-data-service/.../kafka-acls.yml">
      <mxGeometry x="52" y="250" width="876" height="32" as="geometry"/>
    </mxCell>
    <mxCell id="p5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=left;spacingLeft=14;" value="audit-service/.../kafka-acls.yml &#183; only the ALLOW half; everything else is denied">
      <mxGeometry x="52" y="288" width="876" height="32" as="geometry"/>
    </mxCell>

    <mxCell id="parser" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=16;verticalAlign=top;spacingTop=12;" value="&lt;b&gt;KafkaAclPolicy&lt;/b&gt; &#183; platform-common test fixtures, the only parser&lt;br&gt;&lt;br&gt;load() from the calling module's classpath &#183; loadFile() by path, for the stack &#183; topics() every topic the policy names">
      <mxGeometry x="30" y="366" width="920" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="e1" parent="1" source="src" target="parser" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;strokeWidth=3;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="c1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=16;verticalAlign=top;spacingTop=12;" value="&lt;b&gt;Consumer A &#183; the tests&lt;/b&gt;&lt;br&gt;&lt;br&gt;SecureKafkaStack.apply(policy) creates the topics and the ALLOW bindings on a real broker.&lt;br&gt;&lt;br&gt;The contract first asserts that the principal in the file matches the identity under test.">
      <mxGeometry x="30" y="520" width="450" height="170" as="geometry"/>
    </mxCell>
    <mxCell id="c2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=left;spacingLeft=16;verticalAlign=top;spacingTop=12;" value="&lt;b&gt;Consumer B &#183; the local stack&lt;/b&gt;&lt;br&gt;&lt;br&gt;./gradlew renderKafkaAcls writes build/kafka-acls.args.&lt;br&gt;&lt;br&gt;local-stack.sh feeds each line to kafka-acls.sh --add: 13 ACLs on the strict-security profile.">
      <mxGeometry x="500" y="520" width="450" height="170" as="geometry"/>
    </mxCell>
    <mxCell id="e2" parent="1" source="parser" target="c1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;endArrow=block;strokeWidth=3;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e3" parent="1" source="parser" target="c2" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=block;strokeWidth=3;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="broker" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacingLeft=16;verticalAlign=top;spacingTop=12;strokeWidth=2;" value="&lt;b&gt;The setting the whole thing rests on&lt;/b&gt;&lt;br&gt;&lt;br&gt;allow.everyone.if.no.acl.found=false, with the StandardAuthorizer.&lt;br&gt;&lt;br&gt;An absent grant is a denial, not a pass. Without it the ALLOW list is decoration and every DENY assertion passes vacuously.">
      <mxGeometry x="30" y="720" width="920" height="130" as="geometry"/>
    </mxCell>

    <mxCell id="proofhdr" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" value="Both halves are asserted, in both places">
      <mxGeometry x="30" y="876" width="920" height="26" as="geometry"/>
    </mxCell>
    <mxCell id="pr1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;Per producer identity&lt;/b&gt;&lt;br&gt;&lt;br&gt;ALLOW write the topic it owns&lt;br&gt;DENY read the topic it writes&lt;br&gt;DENY write another service's topic">
      <mxGeometry x="30" y="912" width="298" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="pr2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;For the one consumer identity&lt;/b&gt;&lt;br&gt;&lt;br&gt;ALLOW read through its own group&lt;br&gt;DENY write a financial topic&lt;br&gt;DENY join another workload's group">
      <mxGeometry x="341" y="912" width="298" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="pr3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;In the stack, at provisioning time&lt;/b&gt;&lt;br&gt;&lt;br&gt;trade-producer to trades.raw must succeed&lt;br&gt;trade-producer to market-data.ticks must be refused&lt;br&gt;&lt;br&gt;Both probes send a real record.">
      <mxGeometry x="652" y="912" width="298" height="140" as="geometry"/>
    </mxCell>

    <mxCell id="caveat" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#666666;" value="What this does not prove: that a deployed service authenticates as its own principal. The services are not containerised yet, so the identity binding is still open. Cloud deployments authorise with MSK IAM; ACLs exist for this local profile.">
      <mxGeometry x="30" y="1070" width="920" height="60" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
