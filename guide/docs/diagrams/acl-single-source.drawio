<mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1480" pageHeight="880" math="0" shadow="0" adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="title" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" value="One policy file, one parser, two consumers">
      <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="sub" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="The permissions a test proves and the permissions a running broker applies come from the same committed file, read by the same code. Two readers would be two chances to drift.">
      <mxGeometry x="40" y="50" width="1300" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="policies" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;" value="Source of truth &#183; one file per service, in that service's own module">
      <mxGeometry x="40" y="100" width="380" height="306" as="geometry"/>
    </mxCell>
    <mxCell id="pol1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" value="trade-producer/src/main/resources/security/kafka-acls.yml">
      <mxGeometry x="60" y="152" width="340" height="42" as="geometry"/>
    </mxCell>
    <mxCell id="pol2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" value="market-data-simulator/.../kafka-acls.yml">
      <mxGeometry x="60" y="202" width="340" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="pol3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" value="corporate-action-producer/.../kafka-acls.yml">
      <mxGeometry x="60" y="244" width="340" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="pol4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" value="reference-data-service/.../kafka-acls.yml">
      <mxGeometry x="60" y="286" width="340" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="pol5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" value="audit-service/.../kafka-acls.yml">
      <mxGeometry x="60" y="328" width="340" height="34" as="geometry"/>
    </mxCell>
    <mxCell id="polnote" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;" value="Only the ALLOW half lives in the file. Everything else is denied by the broker.">
      <mxGeometry x="60" y="368" width="340" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="parser" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="KafkaAclPolicy&#10;platform-common test fixtures&#10;&#10;record KafkaAclPolicy(String principal, List of Grant allowed)&#10;record Grant(ResourceType, String name, List of AclOperation)&#10;&#10;load()      from the calling module's classpath&#10;loadFile()  by path, for the stack&#10;topics()    every topic the policy names">
      <mxGeometry x="500" y="150" width="420" height="190" as="geometry"/>
    </mxCell>

    <mxCell id="consumer1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="Consumer A &#183; the tests&#10;&#10;SecureKafkaStack.apply(policy)&#10;creates the topics and the ALLOW bindings on a real broker&#10;&#10;KafkaProducerAuthorizationContract asserts the principal in the file matches the test, then runs one ALLOW and two DENY">
      <mxGeometry x="1000" y="106" width="460" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="consumer2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" value="Consumer B &#183; the local stack&#10;&#10;./gradlew renderKafkaAcls&#10;KafkaAclScriptRenderer writes build/kafka-acls.args&#10;&#10;local-stack.sh feeds each line to kafka-acls.sh --add&#10;13 ACLs applied on the strict-security profile">
      <mxGeometry x="1000" y="336" width="460" height="190" as="geometry"/>
    </mxCell>

    <mxCell id="c1" parent="1" source="policies" target="parser" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;endArrow=block;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="c2" parent="1" source="parser" target="consumer1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;endArrow=block;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="c3" parent="1" source="parser" target="consumer2" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=block;strokeWidth=2;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="broker" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontStyle=1;" value="The setting the whole thing rests on&#10;&#10;allow.everyone.if.no.acl.found=false&#10;&#10;with org.apache.kafka.metadata.authorizer.StandardAuthorizer&#10;&#10;An absent grant is a denial, not a pass. Without this line the ALLOW list would be decoration and every DENY assertion would be vacuous.">
      <mxGeometry x="500" y="380" width="420" height="180" as="geometry"/>
    </mxCell>

    <mxCell id="proof" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;" value="Both halves are asserted, in both places">
      <mxGeometry x="40" y="600" width="1400" height="240" as="geometry"/>
    </mxCell>
    <mxCell id="pr1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="In the tests, per producer identity&#10;&#10;ALLOW  write the topic this identity owns&#10;DENY   read the topic this identity writes, by assign() rather than subscribe(), so no group grant decides first&#10;DENY   write another service's topic, and for trade-producer that topic is trades.enriched, because a producer that could write it could inject trades that skipped enrichment">
      <mxGeometry x="65" y="640" width="440" height="180" as="geometry"/>
    </mxCell>
    <mxCell id="pr2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="In the tests, for the one consumer identity&#10;&#10;ALLOW  read the four evidence topics, write the four .dlq topics&#10;DENY   write a financial topic&#10;DENY   join a consumer group other than audit-service&#10;&#10;The GROUP grant is scoped to the group whose name equals the service name.">
      <mxGeometry x="530" y="640" width="440" height="180" as="geometry"/>
    </mxCell>
    <mxCell id="pr3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" value="In the stack, at provisioning time&#10;&#10;verify_least_privilege sends a real record twice:&#10;&#10;trade-producer &#8594; trades.raw          must succeed&#10;trade-producer &#8594; market-data.ticks   must be refused&#10;&#10;A denial alone would not distinguish an enforced policy from a client that cannot connect at all, so bringing the stack up fails if either half is wrong.">
      <mxGeometry x="995" y="640" width="440" height="180" as="geometry"/>
    </mxCell>

    <mxCell id="caveat" parent="1" vertex="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" value="What this does not prove: that a deployed service authenticates as its own principal. The services are not containerised yet, so the identity binding is still open. Cloud deployments authorise with MSK IAM; ACLs exist for this local profile.">
      <mxGeometry x="40" y="850" width="1400" height="30" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
