{
  "permissions": {
    "deny": [
      "Bash(rm -rf*)",
      "Edit(.env*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(docker compose down -v*)"
    ],
    "allow": [
      "Bash(./gradlew*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)"
    ]
  }
}
